# Nonsecret template only. Keep the actual operator environment outside Git.
# Required: replace with a qualified immutable registry/repository@sha256 digest.
# Source template only: historical wheel/image recipe is NOT dual-OAuth qualified.
# New packaging/image, operator enrollment and cutover approvals remain gates.
GOOGLE_SEO_IMAGE=
# Existing protected operator directory, read/traverse accessible to UID/GID10001.
# Contains required consumer-keys.json; OAuth slots may be absent/pending.
# Never expose the retired SA rollback document to the active OAuth runtime.
GOOGLE_SEO_SECRETS_DIR=/etc/propel-mcp/google-seo
# Compose publishes host3006 -> container8000. Set approved interface/ACL explicitly.
GOOGLE_SEO_BIND_ADDRESS=0.0.0.0
GOOGLE_SEO_PUBLIC_BASE_URL=https://google-seo.mcp.propel.marketing
GOOGLE_SEO_ACCEPTED_HOSTS=google-seo.mcp.propel.marketing,localhost:8000,127.0.0.1:8000,[::1]:8000,localhost:3006,127.0.0.1:3006,[::1]:3006
GOOGLE_SEO_ACCEPTED_ORIGINS=https://google-seo.mcp.propel.marketing
GOOGLE_SEO_REQUIRE_GOOGLE_CREDENTIALS=false

# Fixed by Compose; these document the matching direct-process boundary.
# Changing these entries here does not override Compose's hardcoded safeguards.
GOOGLE_SEO_TRANSPORT=streamable-http
GOOGLE_SEO_PROFILE=production
GOOGLE_SEO_AUTH_MODE=dual-user-oauth
GOOGLE_SEO_HOST=0.0.0.0
GOOGLE_SEO_PORT=8000
GOOGLE_SEO_CONSUMER_KEYS_FILE=/run/secrets/consumer-keys.json
GOOGLE_SEO_OAUTH_CLIENT_FILE=/run/secrets/google-seo-oauth-client.json
GOOGLE_SEO_OAUTH_PROPEL_DMS_FILE=/run/secrets/google-seo-oauth-propel-dms.json
GOOGLE_SEO_OAUTH_ADDOURTEAM99_FILE=/run/secrets/google-seo-oauth-addourteam99.json
# Nonsecret bindings forwarded by Compose; actual operator-approved values UNKNOWN.
# Empty values deliberately refuse Compose interpolation; do not invent identifiers.
GOOGLE_SEO_APPROVED_CLIENT_ID=
GOOGLE_SEO_APPROVED_PROJECT_ID=
# Optional Bing: paths only, same read-only /run/secrets mount; no key value.
# Do not create/materialize the key before the runbook HOLD/resume gate.
# Provider discovery replaces policy; leftover policy retirement is operator-only.
GOOGLE_SEO_BING_CREDENTIALS_FILE=/run/secrets/bing-webmaster.json

# Compose forwards this boolean; keep false until separately authorized qualification.
GOOGLE_SEO_REQUIRE_BING_CREDENTIALS=false
GSC_ALLOW_DESTRUCTIVE=false
GOOGLE_SEO_ALLOW_INDEXNOW=false
GOOGLE_SEO_ALLOW_PRIVATE_FETCH=false
GOOGLE_SEO_ALLOW_LOCAL_FILES=false
GOOGLE_SEO_DEBUG=false

# Inject DATAFORSEO_LOGIN and DATAFORSEO_PASSWORD only through the approved
# operator secrets mechanism when separately authorized; absent is intentional.
# GOOGLE_SEO_SMOKE_KEY is injected into the smoke process only, never this file.
# GOOGLE_SEO_REVISION is baked at image build from the reviewed main Git SHA;
# Compose deliberately supplies no runtime override.
